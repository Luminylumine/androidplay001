<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- ============== 区块 1: 权限与通道状态 ============== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="── 权限与通道状态 ──"
        android:textStyle="bold"
        android:textColor="#0a66c2"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tvShellStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:text="Shell 通道: 检测中…"/>

        <Button
            android:id="@+id/btnShellRecheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:textSize="11sp"
            android:text="重新检测"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvDhizukuStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:text="Dhizuku: 检测中…"/>

        <Button
            android:id="@+id/btnDhizuku"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:textSize="11sp"
            android:text="授予/打开"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvShizukuStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:text="Shizuku: 检测中…"/>

        <Button
            android:id="@+id/btnShizuku"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:textSize="11sp"
            android:text="授予/打开"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnWireless"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:text="无线调试配对（Android 11+，经 Shizuku 启动）"/>

    <TextView
        android:id="@+id/tvShotStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:text="屏幕捕获(mediaProjection): 检测中…"/>

    <TextView
        android:id="@+id/tvA11yStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:text="无障碍服务: 检测中…"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvBatteryStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:text="电池优化: 检测中…"/>

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:textSize="11sp"
            android:text="去设置"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvLogPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="11sp"
        android:textColor="#666666"
        android:text="日志文件: 检测中…"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="说明: Shell(uid 2000) 通道以 Shizuku 为准 — Shizuku server 运行后，点右侧「Shizuku」按钮完成授权即可，Agent 直接读屏/点击/执行命令。无「无线调试」配对界面的系统可用 adb 无线端口启动(点「Shizuku」查看步骤)；重启后需重做。Dhizuku 提供 Device Owner 设备管理能力，不提供 shell，不参与通道。"
        android:textSize="11sp"
        android:textColor="#999999"/>

    <!-- ============== 区块 2: 开机自启总门控 ============== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="── 开机自启（总门控）──"
        android:textStyle="bold"
        android:textColor="#0a66c2"/>

    <CheckBox
        android:id="@+id/cbAutoStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="开机自启总开关（启用后，各 Agent 里勾选了自启的才会被唤起；未勾选的不启动）"
        android:textSize="13sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="11sp"
        android:textColor="#999999"
        android:text="单个 Agent 的自启开关在通讯录 → 对应 Agent → API 配置区块。"/>

    <!-- ============== 区块 3: 设置子菜单入口（可展开） ============== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="── 设置子菜单 ──"
        android:textStyle="bold"
        android:textColor="#0a66c2"/>

    <LinearLayout
        android:id="@+id/llSettingsToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#F5F5F5"
        android:padding="10dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        style="?android:attr/borderlessButtonStyle">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="⚙  设置（默认运行参数 / 默认 API fallback / 经验池保留等）"/>

        <TextView
            android:id="@+id/tvSettingsArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#666666"
            android:text="▸"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llSettingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="默认任务目标（启动时输入框为空则用它）"
            android:textSize="12sp"
            android:textColor="#666666"/>

        <EditText
            android:id="@+id/etGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:gravity="top"
            android:hint="例如：打开天气应用查看今天天气"
            android:textSize="13sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="— 默认 API（未单独配置 API 的 Agent 会使用这组）—"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#0a66c2"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Base URL（填到 /v1 即可，纯域名会自动补 /v1）"
            android:textSize="12sp"
            android:textColor="#666666"/>

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://api.llm.ustc.edu.cn/v1"
            android:inputType="textUri"
            android:textSize="13sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="API Key"
            android:textSize="12sp"
            android:textColor="#666666"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="sk-..."
                android:inputType="textPassword"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnKeyVis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:minWidth="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textSize="12sp"
                android:text="显示"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="默认模型（新建会话时未显式选 Agent 则用它）"
            android:textSize="12sp"
            android:textColor="#666666"/>

        <Spinner
            android:id="@+id/spModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:text="测试默认连接（发一个最小请求）"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="— 运行参数（作为所有 Agent 的 fallback 默认值）—"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#0a66c2"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="最大输出 tokens:"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/etMax"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:inputType="number"
                android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="轮次间隔(秒):"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/etInterval"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:inputType="number"
                android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="历史轮数(0=无):"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/etHistory"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:inputType="number"
                android:textSize="13sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="— 全局经验池保留策略 —"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#0a66c2"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保留时间(天,0=不限):"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/etExpDays"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:inputType="number"
                android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保留大小(条,0=不限):"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/etExpMax"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:inputType="number"
                android:textSize="13sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="自动清理：每次进入 App 时异步排查删除过期/超量经验；写入新经验后也会自动删除最老的。"
            android:textSize="11sp"
            android:textColor="#999999"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="11sp"
            android:textColor="#999999"
            android:text="提示: 单个 Agent 的 Base URL / API Key / 自启开关 / 权限 / Prompt，请前往「通讯录」→ 对应 Agent 中设置。"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="14sp"
            android:text="保存设置"/>
    </LinearLayout>

    <!-- 底部留白 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
</LinearLayout>
