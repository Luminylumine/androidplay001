<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- top bar (reserved for future header / title / pinned controls) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="16dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="Akasha"/>

        <TextView
            android:id="@+id/btnVoiceCallTop"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="10dp"
            android:text="📞 通话"
            android:textSize="14sp"
            android:textColor="#0A66C2"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/btnNewChatTop"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="20dp"
            android:text="＋"
            android:textSize="22sp"
            android:textColor="#0A66C2"/>
    </LinearLayout>

    <!-- tab content (kept-alive views toggled by the bottom nav) -->
    <FrameLayout
        android:id="@+id/flContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

        <TextView
            android:id="@+id/tabChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="💬\n聊天"
            android:textSize="12sp"
            android:textColor="#0A66C2"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tabContacts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👥\n通讯录"
            android:textSize="12sp"
            android:textColor="#888888"/>

        <TextView
            android:id="@+id/tabDiscover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🔍\n发现"
            android:textSize="12sp"
            android:textColor="#888888"/>

        <TextView
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙\n全局"
            android:textSize="12sp"
            android:textColor="#888888"/>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
