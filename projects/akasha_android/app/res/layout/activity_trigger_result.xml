<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/resultRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 顶栏: 返回(红) / 清空重选(黄) / 确定(蓝) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTrBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="返回"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="#D9433B"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnTrReset"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="清空重选"
            android:textSize="14sp"
            android:textColor="#000000"
            android:background="#FFC107"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnTrOk"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="确定"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="#0A66C2"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTrTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:background="#FFFFFF"
        android:text="触发结果"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="触发后对 Agent 做什么:"
                android:textSize="13sp"
                android:textColor="#666666"/>

            <RadioGroup
                android:id="@+id/rgTrType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rbTrMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="发送指定信息（可选发送方式）"
                    android:textSize="14sp"/>

                <RadioButton
                    android:id="@+id/rbTrContinue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="发送「继续」"
                    android:textSize="14sp"/>
            </RadioGroup>

            <!-- 指定信息: 发送方式 + 内容 -->
            <LinearLayout
                android:id="@+id/llTrMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="发送方式:"
                    android:textSize="12sp"
                    android:textColor="#666666"/>

                <RadioGroup
                    android:id="@+id/rgTrMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp">

                    <RadioButton
                        android:id="@+id/rbTrQueue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="排队（当前任务结束后再执行）"
                        android:textSize="13sp"/>

                    <RadioButton
                        android:id="@+id/rbTrInterrupt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="打断并发送（立即中断当前任务）"
                        android:textSize="13sp"/>

                    <RadioButton
                        android:id="@+id/rbTrGuide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="引导（注入实时引导，不打断）"
                        android:textSize="13sp"/>
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="发送内容:"
                    android:textSize="12sp"
                    android:textColor="#666666"/>

                <EditText
                    android:id="@+id/etTrMsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minLines="3"
                    android:gravity="top"
                    android:hint="例如：检查一下天气并把结果写入 weather.txt"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
