<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.akasha.app"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="29"/>

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- granted by the Dhizuku app when the user whitelists us -->
    <uses-permission android:name="com.rosan.dhizuku.permission.API"/>
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23"/>

    <application
        android:label="@string/app_name"
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"/>

        <activity
            android:name=".ChatActivity"
            android:exported="false"/>

        <activity
            android:name=".ModelSettingsActivity"
            android:exported="false"/>

        <activity
            android:name=".TimerWakeupActivity"
            android:exported="false"/>

        <activity
            android:name=".TriggerSourcePickerActivity"
            android:exported="false"/>

        <activity
            android:name=".TriggerResultActivity"
            android:exported="false"/>

        <activity
            android:name=".LogDetailActivity"
            android:exported="false"/>

        <activity
            android:name=".ExperiencePoolActivity"
            android:exported="false"/>

        <activity
            android:name=".EditExperienceActivity"
            android:exported="false"
            android:label="编辑经验"/>

        <activity
            android:name=".PublishExperienceActivity"
            android:exported="false"/>

        <activity
            android:name=".ImageViewerActivity"
            android:exported="false"/>

        <activity
            android:name=".SessionSettingsActivity"
            android:exported="false"/>

        <activity
            android:name=".PromptEditorActivity"
            android:exported="false"/>

        <activity
            android:name=".SettingsDetailActivity"
            android:exported="false"/>

        <activity
            android:name=".AgentDialogsPickerActivity"
            android:exported="false"/>

        <activity
            android:name=".SearchPickerActivity"
            android:exported="false"/>

        <!-- Shizuku: binder carrier -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.akasha.app.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"/>

        <!-- run by Shizuku/Dhizuku inside their privileged process -->
        <service
            android:name=".AkashaShellService"
            android:exported="false"/>

        <service
            android:name=".AgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <service
            android:name=".ScreenShotService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"/>

        <service
            android:name=".ControlService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config"/>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
