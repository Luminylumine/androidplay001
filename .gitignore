# ============== Privacy Sensitive Files ==============
# NEVER commit real personal data, device photos, SMS/accounts dumps
**/dcim_latest/
**/personal_surface/
**/photos_extracted/

# ADB private keys (leak = full device access without auth prompt)
# Precise patterns ON PURPOSE: the old **/adbkey* also matched the Java source
# AdbKey.java (case-insensitive on Windows) and silently dropped it from git.
**/adbkey
**/adbkey.pub
**/adbkey_b64.txt
# Source file embedding the test-device ADB key — kept local only, never pushed
**/AdbKey.java
*.p12
*.pfx

# APK signing keystores (leak = forged APKs with same signature / system perms)
*.keystore
*.jks

# ============== Toolchains (large non-redistributable binaries) ==============
tools/
downloads/

# ============== Compiled / Build Artifacts ==============
# Java/Android builds
**/build/
**/gen/
**/obj/
**/*.dex
**/*.apk
**/*.apk.idsig
**/*.so

# All .jar by default, EXCEPT source-level SDK deps under libs/ or common/sdks/
**/*.jar
!**/libs/**/*.jar
!**/sdks/**/*.jar

# .NET / WinForms
**/bin/
**/obj/
*.pdb
*.dll
*.exe

# ============== Project Specific ==============
# Compiled LPE / exploit aarch64 binaries (per-device, large, non-redistributable)
**/exploits/lpe_*
**/exploits/orig_poc
**/exploits/lpe_diag
**/exploits/diag_slab_alloc
**/exploits/v10_sanity
**/exploits/slab_rb_reclaim_uaf

# ============== Reference Source (not needed for builds) ==============
common/sdks/shizuku/sz_src/
common/sdks/shizuku/sz_v1320.tar.gz
common/sdks/dhizuku/dz260/

# Misc OS / editor files
Thumbs.db
.DS_Store
*.swp
*.swo
.idea/
.vscode/
